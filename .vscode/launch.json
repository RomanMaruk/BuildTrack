{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug api with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "api", "--configuration=development"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "outFiles": [
        "${workspaceFolder}/dist/apps/api/**/*.js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Debug web in Chrome",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve web",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Debug full stack",
      "configurations": ["Debug api with Nx", "Debug web in Chrome"],
      "stopAll": true
    }
  ]
}
